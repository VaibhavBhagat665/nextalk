# PRODUCTION-READY Dockerfile for Socket.io Server
# Optimized to skip heavy dependencies that aren't essential

FROM node:20-alpine AS base

WORKDIR /app

# ============================================================================
# Stage 1: Dependencies Installation
# ============================================================================
FROM base AS deps

# Install only essential build tools
RUN apk add --no-cache \
    python3 \
    make \
    g++

# Copy dependency files
COPY package*.json ./
COPY packages ./packages
COPY prisma ./prisma

# Install dependencies but IGNORE mediasoup postinstall failures
# Mediasoup is optional - server works without SFU features
RUN npm install --production --prefer-offline --ignore-scripts || true

# Run only essential postinstall scripts
RUN npx prisma generate

# Install runtime tools
RUN npm install --no-save tsx@4.23.15

# ============================================================================
# Stage 2: Production Runtime
# ============================================================================
FROM base AS runner

WORKDIR /app

# Copy dependencies from builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/prisma ./prisma

# Copy source code
COPY server ./server
COPY lib ./lib
COPY package*.json ./

# Set production environment
ENV NODE_ENV=production
ENV PORT=3001
ENV SKIP_SFU=true

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs && \
    chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server
CMD ["npx", "tsx", "server/socket-server.ts"]
