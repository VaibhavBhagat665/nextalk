# NPM configuration
# Note: Vercel needs optional deps for lightningcss, but Render backend doesn't

# Skip optional dependencies ONLY on backend (Docker uses --ignore-scripts instead)
# optional=false

# Disable audit/fund during install (saves time)
audit=false
fund=false

# Use cache efficiently
prefer-offline=true
cache-min=86400

# Reduce concurrent operations
maxsockets=5
