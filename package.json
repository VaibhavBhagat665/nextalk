{
  "name": "nextalk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"tsx --watch server/socket-server.ts\"",
    "dev:next": "next dev --turbopack",
    "dev:socket": "tsx --watch server/socket-server.ts",
    "build": "next build",
    "start": "next start",
    "start:socket": "npx tsx server/socket-server.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "benchmark:baseline": "powershell -ExecutionPolicy Bypass -File ./benchmarks/run-baseline.ps1",
    "benchmark:quick": "k6 run --vus 100 --duration 30s benchmarks/load-test.js",
    "db:profile": "tsx benchmarks/profile-queries.ts",
    "db:seed": "tsx prisma/seed-messages.ts",
    "db:setup-pgvector": "tsx scripts/setup-pgvector.ts",
    "backfill:embeddings": "tsx scripts/backfill-embeddings.ts",
    "test:backfill-performance": "tsx scripts/test-backfill-performance.ts",
    "test:cross-instance": "tsx tests/cross-instance-test.ts",
    "test:single-instance": "tsx tests/single-instance-test.ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@clerk/themes": "^2.4.57",
    "@nextalk/crypto": "workspace:*",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.6.3",
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.75.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/express": "^5.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "groq-sdk": "^0.17.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.510.0",
    "mediasoup": "^3.27.1",
    "mediasoup-client": "^3.24.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "^1.8.11",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "svix": "^1.62.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "^4.10.2",
    "prisma": "^6.9.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
