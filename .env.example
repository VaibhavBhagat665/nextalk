# ============================================================
# NexTalk Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# ============================================================

# ── Clerk Authentication ─────────────────────────────────────
# 1. Go to https://clerk.com → Sign up / Sign in
# 2. Create a new application → choose "Next.js"
# 3. Copy the keys from the dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── PostgreSQL Database (Railway) ────────────────────────────
# 1. Go to https://railway.app → New Project → Add PostgreSQL
# 2. Click on the PostgreSQL service → Variables tab
# 3. Copy DATABASE_URL (starts with postgresql://...)
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Upstash Redis (Pub/Sub for Socket.io) ────────────────────
# 1. Go to https://upstash.com → Create a Redis Database
# 2. IMPORTANT: Use the TLS endpoint (starts with rediss://)
# 3. Found in: Database → Details → Endpoint (TLS)
UPSTASH_REDIS_URL=rediss://default:password@hostname:port
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token

# ── Cloudinary (File/Image Uploads) ──────────────────────────
# 1. Go to https://cloudinary.com → Sign up
# 2. Dashboard → Copy cloud name, API key, API secret
# 3. Settings → Upload → Add unsigned upload preset → copy name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=nextalk_uploads

# ── Groq AI (Free Llama 3.1 — Thread Summarization) ─────────
# 1. Go to https://console.groq.com → Sign up (free, no CC)
# 2. API Keys → Create API Key → copy it
GROQ_API_KEY=gsk_...

# ── Encryption ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=your_64_char_hex_string_here

# ── Socket.io Server ────────────────────────────────────────
# For local dev, the socket server runs on port 3001
# For production, set this to your Railway socket server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
