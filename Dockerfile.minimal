# Extreme minimal Docker image for free tier
FROM node:20-alpine

WORKDIR /app

# Install build essentials (minimal)
RUN apk add --no-cache python3 make g++

# Copy package files INCLUDING workspace packages
COPY package*.json ./
COPY packages ./packages

# Install PRODUCTION only (NO canvas!)
RUN npm install --production --prefer-offline && \
    npm install --no-save prisma tsx && \
    npm cache clean --force

# Copy prisma
COPY prisma ./prisma/

# Generate Prisma (then clean up)
RUN npx prisma generate && \
    rm -rf /tmp/* /root/.npm

# Copy server code only
COPY server ./server
COPY lib ./lib

# Remove unnecessary files to save space
RUN rm -rf /usr/share/man/* /tmp/* /var/cache/apk/* \
    packages/crypto/src \
    packages/crypto/*.test.* \
    packages/crypto/tsconfig.json

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001

CMD ["npx", "tsx", "server/socket-server.ts"]
